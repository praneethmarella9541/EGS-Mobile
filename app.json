{
  "expo": {
    "name": "EGS CRM",
    "slug": "egs-mobile",
    "version": "1.0.0",
    "scheme": "egscrm",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.egs.crm"
    },
    "android": {
      "package": "in.egs.crm",
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "egscrm",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EGS CRM uses your location to verify attendance at the assigned site."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "EGS CRM uses the camera to capture your attendance photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dabda90c-7c4f-4454-9177-a45dee37a24d"
      }
    },
    "owner": "dreamerslabs"
  }
}
