{
  "expo": {
    "name": "The Nucleus - Marketing",
    "slug": "egs-field-attendance",
    "version": "1.0.0",
    "scheme": "egscrm",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thenucleus.crm",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "The Nucleus - Marketing uses speech recognition to convert your dictated notes to text.",
        "NSMicrophoneUsageDescription": "The Nucleus - Marketing uses the microphone to let you dictate notes."
      }
    },
    "android": {
      "package": "com.thenucleus.crm",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "egscrm",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "The Nucleus - Marketing uses your location to verify attendance at the assigned site."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "The Nucleus - Marketing uses the camera to capture your attendance photo."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "The Nucleus - Marketing uses the microphone to let you dictate notes.",
          "speechRecognitionPermission": "The Nucleus - Marketing uses speech recognition to convert your dictated notes to text."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "The Nucleus - Marketing needs access to your photos to save downloaded images.",
          "savePhotosPermission": "The Nucleus - Marketing needs permission to save images to your photo library.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C45C1A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4bbce316-1865-4f9d-ade7-ad38eef12560"
      }
    },
    "owner": "dreamerslabs"
  }
}
